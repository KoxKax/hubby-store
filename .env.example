# Phase 0 runs without any secrets or external services.
# Future bindings are configured server-side; never add a VITE_ prefix to secrets.
# Supabase publishable key is not an authorization control; RLS remains required.
APP_ENV=local
DATA_MODE=fixtures
PAYMENTS_MODE=mock
SUPPLIERS_MODE=mock
# Staging opt-in only; see docs/STAGING_SETUP.md. Never commit .dev.vars.
# SUPABASE_ENVIRONMENT=staging
# SITE_ORIGIN=http://127.0.0.1:5174
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# INVENTORY_ENCRYPTION_KEY_V1=
# INVENTORY_FINGERPRINT_KEY=
# SEPAY_WEBHOOK_SECRET=
# RESEND_API_KEY=

