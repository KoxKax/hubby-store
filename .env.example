# Phase 0 runs without any secrets or external services.
# Future bindings are configured server-side; never add a VITE_ prefix to secrets.
# Supabase publishable key is not an authorization control; RLS remains required.
APP_ENV=local
DATA_MODE=fixtures
PAYMENTS_MODE=mock
# PAYOS_CHECKOUT_READY=true # Only after inventory, settlement and fulfillment UAT
SUPPLIERS_MODE=mock
# Existing Worker only: private Bite setup; leave flags absent until DB ready.
# BITE_API_KEY=
# BITE_SCHEMA_READY=true
# BITE_READY=true
# BITE_TRACKING_READY=true
# SUPPLIERS_MODE=bite
# Staging opt-in only; see docs/STAGING_SETUP.md. Never commit .dev.vars.
# SUPABASE_ENVIRONMENT=staging
# SITE_ORIGIN=http://127.0.0.1:5174
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=  # Server-only, never exposed in browser
# INVENTORY_ENCRYPTION_KEY_V1=
# INVENTORY_FINGERPRINT_KEY=
# SEPAY_WEBHOOK_SECRET=
# Future OCB/Casso setup only; no live activation by adding these names.
# CASSO_WEBHOOK_SECRET=
# CASSO_OCB_ACCOUNT_NUMBER=
# CASSO_OCB_VIRTUAL_ACCOUNT_NUMBER=
# payOS credentials: keep in ignored local vars / Workers secret store only.
# Never reuse credentials disclosed in a chat or commit them to Git.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# RESEND_API_KEY=

